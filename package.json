{
  "name": "@flashjames/leky-backend-medusa",
  "version": "5.0.5",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json",
    "dev": "medusa develop",
    "start": "medusa start",
    "start:prod": "medusa db:migrate && medusa start",
    "test": "jest",
    "seed": "medusa exec ./data/seed.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "^2.0.0",
    "@medusajs/draft-order": "^2.22.6",
    "@medusajs/framework": "2.22.6",
    "@medusajs/medusa": "2.22.6",
    "algoliasearch": "^4.27.0",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "16.3.1",
    "express": "^4.17.2",
    "fs-extra": "^11.4.1",
    "picocolors": "^1.1.1",
    "pm2": "^5.3.1"
  },
  "devDependencies": {
    "@medusajs/cli": "2.22.6",
    "@types/express": "^4.17.13",
    "@types/fs-extra": "^11",
    "@types/jest": "^27.4.0",
    "@types/node": "^17.0.8",
    "cross-env": "^7.0.3",
    "eslint": "^6.8.0",
    "jest": "^27.3.1",
    "rimraf": "^3.0.2",
    "ts-jest": "^27.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.spec.json"
      }
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/node_modules/"
    ],
    "rootDir": "src",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|js)$",
    "transform": {
      ".ts": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "resolutions": {
    "webpack": "5.84.1",
    "webpackbar": "5.0.2"
  }
}
